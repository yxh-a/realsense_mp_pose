<robot name="upper_arm">

    <material name="color">
        <color rgba="0 1 0 1"/>
    </material>

    <link name="camera_depth_optical_frame"/>

    <joint name="gt_world_to_shoulder" type="fixed">
        <parent link="camera_depth_optical_frame"/>
        <child link="gt_RightShoulder"/>
        <origin xyz="-0.12466341 -0.152376    1.07400005" rpy="3.14 1.57 0"/>
    </joint>
        <!-- === Trunk slab (torso) === -->
    <link name="gt_Trunk">
        <inertial>
            <!-- Give it a small but nonzero mass to avoid NaNs -->
            <mass value="5.0"/>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <!-- Rough, diagonal-dominant inertia for a 0.40 x 0.25 x 0.55 m box -->
            <inertia ixx="0.5" iyy="0.8" izz="0.5" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <!-- size = [width_x, depth_y, height_z] -->
            <geometry>
                <cylinder length="0.4" radius="0.02"/>
            </geometry>
            <material name="color">
                <!-- subtle gray so the arm (green) stands out -->
                <color rgba="0.6 0.6 0.6 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.4" radius="0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="gt_jShoulder_to_trunk" type="fixed">
        <origin xyz="0 0 -0.20" rpy="0 0 0"/>
        <parent link="gt_RightShoulder"/>
        <child link="gt_Trunk"/>
    </joint>

    <!--  shoudler, 3DOF -->
    <link name="gt_RightShoulder">


        <visual>
			<!--box origin wrt jRightC7Shoulder. RPY rotated of pi/2.-->
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>

    <joint name="gt_jRightShoulder_rotx" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="gt_RightShoulder"/>
        <child link="gt_RightUpperArm_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-2.35619" upper="1.5708" />
        <axis xyz="1 0 0" />
    </joint>

    <link name="gt_RightUpperArm_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gt_jRightShoulder_rotz" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="gt_RightUpperArm_f1"/>
        <child link="gt_RightUpperArm_f2"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-0.785398" upper="1.5708" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="gt_RightUpperArm_f2">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gt_jRightShoulder_roty" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="gt_RightUpperArm_f2"/>
        <child link="gt_RightUpperArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.5708" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- elbow, 3 dof -->
    <link name="gt_RightUpperArm">
        <inertial>
            <mass value="2.181"/>
			<!--COM origin wrt jRightShoulder-->
            <origin xyz="0    -0.15         0" rpy="0 0 0" />
            <inertia ixx="0.020332" iyy="0.0013806" izz="0.020332" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightShoulder. RPY rotated of pi/2.-->
            <origin xyz="0    -0.15           0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="0.299" radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightShoulder. RPY rotated of pi/2.-->
            <origin xyz="0    -0.15           0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="0.299" radius="0.02"/>
            </geometry>
        </collision>

    </link>

    <joint name="gt_jRightElbow_rotz" type="revolute">
        <origin xyz="0 -0.299 0" rpy="0 0 0"/>
        <parent link="gt_RightUpperArm"/>
        <child link="gt_RightForeArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="0" upper="2.53073" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="gt_RightForeArm">
        <inertial>
            <mass value="1.454"/>
			<!--COM origin wrt jRightElbow-->
            <origin xyz="0    -0.124           0" rpy="0 0 0" />
            <inertia ixx="0.008948" iyy="0.00040906" izz="0.008948" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightElbow. RPY rotated of pi/2.-->
            <origin xyz="0    -0.124           0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="0.248" radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightElbow. RPY rotated of pi/2.-->
            <origin xyz="0    -0.124           0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="0.248" radius="0.02"/>
            </geometry>
        </collision>

    </link>

    <joint name="gt_jRightElbow_roty" type="revolute">
        <origin xyz="0 -0.248 0" rpy="0 0 0"/>
        <parent link="gt_RightForeArm"/>
        <child link="gt_RightForeArm_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.48353" />
        <axis xyz="0 1 0" />
    </joint>

    <link name="gt_RightForeArm_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>

    <!-- wrist 2 dofs -->
    <joint name="gt_jRightWrist_rotx" type="revolute">
        <origin xyz="0    0  0" rpy="0 0 0"/>
        <parent link="gt_RightForeArm_f1"/>
        <child link="gt_RightHand_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.5708" />
        <axis xyz="1 0 0" />
    </joint>

    <link name="gt_RightHand_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="gt_jRightWrist_rotz" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="gt_RightHand_f1"/>
        <child link="gt_RightHand"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-0.723599" upper="0.549066" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="gt_RightHand">
        <inertial>
            <mass value="0.4362"/>
			<!--COM origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <inertia ixx="0.0015471" iyy="0.00073303" izz="0.0021165" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <geometry>
                <box size="0.06    0.085    0.03"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <geometry>
                <box size="0.04     0.133    0.133"/>
            </geometry>
        </collision>

    </link>
    <joint name="gt_jRightHand_COM" type="fixed">
        <origin xyz="0 -0.07 0" rpy="0 0 0"/>
        <parent link="gt_RightHand"/>
        <child link="gt_RightHandCOM"/>
        <axis xyz="0 0 0" />
    </joint>
    <link name="gt_RightHandCOM">
        <inertial>
            <mass value="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <!--box origin wrt jRightWrist-->
            <origin xyz="0   0           0" rpy="0 0 0" />
            <geometry>
                <box size="0     0    0"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>
    
<!-- End of right arm configuration -->
</robot>
