<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="upper_arm">

    <xacro:property name="prefix" value="$(arg robot_prefix)"/>
    <xacro:property name="color" value="$(arg robot_color)"/>
    <xacro:property name="upper_arm_length" value="$(arg upper_arm_length)"/>
    <xacro:property name="upper_arm_com_y" value="${-float(upper_arm_length) / 2.0}"/>
    <xacro:property name="forearm_length" value="$(arg forearm_length)"/>
    <xacro:property name="forearm_com_y" value="${-float(forearm_length) / 2.0}"/>
    <xacro:property name="color_code"  value="${
        '0.35 0.55 0.40 1' if color == 'green' 
        else '0.25 0.45 0.65 1' if color == 'blue' 
        else '0.72 0.70 0.65 1'}"/>

    <material name="color">
        <color rgba="${color_code}"/>
    </material>

    <!-- <link name="camera_depth_optical_frame"/> -->

    <!-- <joint name="${prefix}world_to_shoulder" type="fixed">
        <parent link="camera_depth_optical_frame"/>
        <child link="${prefix}RightShoulder"/>
        <origin xyz="-0.10466341 -0.122376    1.00400005" rpy="3.14 1.57 0"/> 
    </joint> -->
        <!-- === Trunk slab (torso) === -->
    <link name="${prefix}Trunk">
        <inertial>
            <!-- Give it a small but nonzero mass to avoid NaNs -->
            <mass value="5.0"/>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <!-- Rough, diagonal-dominant inertia for a 0.40 x 0.25 x 0.55 m box -->
            <inertia ixx="0.5" iyy="0.8" izz="0.5" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <!-- size = [width_x, depth_y, height_z] -->
            <geometry>
                <cylinder length="0.4" radius="0.02"/>
            </geometry>
            <material name="color">
                <!-- subtle gray so the arm (green) stands out -->
                <color rgba="0.6 0.6 0.6 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.4" radius="0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}jShoulder_to_trunk" type="fixed">
        <origin xyz="0 0 -0.20" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder"/>
        <child link="${prefix}Trunk"/>
    </joint>

    <!--  shoudler, 3DOF -->
    <link name="${prefix}RightShoulder">
       

        <visual>
			<!--box origin wrt jRightC7Shoulder. RPY rotated of pi/2.-->
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>

    <joint name="${prefix}jRightShoulder_rotx" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder"/>
        <child link="${prefix}RightUpperArm_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-2.35619" upper="1.5708" />
        <axis xyz="1 0 0" />
    </joint>

    <link name="${prefix}RightUpperArm_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightShoulder_rotz" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightUpperArm_f1"/>
        <child link="${prefix}RightUpperArm_f2"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-0.785398" upper="1.5708" />
        <axis xyz="0 0 1" />
    </joint>
    
    <link name="${prefix}RightUpperArm_f2">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightShoulder_roty" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightUpperArm_f2"/>
        <child link="${prefix}RightUpperArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.5708" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- elbow, 3 dof -->
    <link name="${prefix}RightUpperArm">
        <inertial>
            <mass value="2.181"/>
			<!--COM origin wrt jRightShoulder-->
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="0 0 0" />
            <inertia ixx="0.020332" iyy="0.0013806" izz="0.020332" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightShoulder. RPY rotated of pi/2.-->
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${upper_arm_length}" radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightShoulder. RPY rotated of pi/2.-->
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${upper_arm_length}" radius="0.02"/>
            </geometry>
        </collision>

    </link>

    <joint name="${prefix}jRightElbow_rotz" type="revolute">
        <origin xyz="0 ${-float(upper_arm_length)} 0" rpy="0 0 0"/>
        <parent link="${prefix}RightUpperArm"/>
        <child link="${prefix}RightForeArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="0" upper="2.53073" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="${prefix}RightForeArm">
        <inertial>
            <mass value="1.454"/>
			<!--COM origin wrt jRightElbow-->
            <origin xyz="0 ${forearm_com_y} 0" rpy="0 0 0" />
            <inertia ixx="0.008948" iyy="0.00040906" izz="0.008948" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightElbow. RPY rotated of pi/2.-->
            <origin xyz="0 ${forearm_com_y} 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${forearm_length}" radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightElbow. RPY rotated of pi/2.-->
            <origin xyz="0 ${forearm_com_y} 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder length="${forearm_length}" radius="0.02"/>
            </geometry>
        </collision>

    </link>
    
    <joint name="${prefix}jRightElbow_roty" type="revolute">
        <origin xyz="0 ${-float(forearm_length)} 0" rpy="0 0 0"/>
        <parent link="${prefix}RightForeArm"/>
        <child link="${prefix}RightForeArm_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.48353" />
        <axis xyz="0 1 0" />
    </joint>

    <link name="${prefix}RightForeArm_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>

    <!-- wrist 2 dofs -->
    <joint name="${prefix}jRightWrist_rotx" type="revolute">
        <origin xyz="0    0  0" rpy="0 0 0"/>
        <parent link="${prefix}RightForeArm_f1"/>
        <child link="${prefix}RightHand_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.5708" />
        <axis xyz="1 0 0" />
    </joint>

    <link name="${prefix}RightHand_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightWrist_rotz" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightHand_f1"/>
        <child link="${prefix}RightHand"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-0.723599" upper="0.549066" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="${prefix}RightHand">
        <inertial>
            <mass value="0.4362"/>
			<!--COM origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <inertia ixx="0.0015471" iyy="0.00073303" izz="0.0021165" ixy="0" ixz="0" iyz="0"/>
        </inertial>

        <visual>
			<!--box origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <geometry>
                <box size="0.06    0.085    0.03"/>
            </geometry>
            <material name="color"/>
        </visual>

        <collision>
			<!--box origin wrt jRightWrist-->
            <origin xyz="0    -0.05           0" rpy="0 0 0" />
            <geometry>
                <box size="0.04     0.133    0.133"/>
            </geometry>
        </collision>

    </link>
    <joint name="${prefix}jRightHandCOM" type="fixed">
        <origin xyz="0 -0.07 0" rpy="0 0 0"/>
        <parent link="${prefix}RightHand"/>
        <child link="${prefix}RightHandCOM"/>
        <axis xyz="0 0 0" />
    </joint>
    <link name="${prefix}RightHandCOM">
        <inertial>
            <mass value="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <!--box origin wrt jRightWrist-->
            <origin xyz="0   0           0" rpy="0 0 0" />
            <geometry>
                <box size="0     0    0"/>
            </geometry>
            <material name="color"/>
        </visual>
    </link>
    
<!-- End of right arm configuration -->
</robot>
