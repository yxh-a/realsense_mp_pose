<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="upper_arm_osim_shoulder_mesh">

    <xacro:arg name="robot_prefix" default=""/>
    <xacro:arg name="robot_color" default="blue"/>
    <xacro:arg name="upper_arm_length" default="0.299"/>
    <xacro:arg name="forearm_length" default="0.248"/>
    <xacro:arg name="hand_length" default="0.0918"/>

    <xacro:property name="prefix" value="$(arg robot_prefix)"/>
    <xacro:property name="color" value="$(arg robot_color)"/>
    <xacro:property name="upper_arm_length" value="$(arg upper_arm_length)"/>
    <xacro:property name="upper_arm_com_y" value="${-float(upper_arm_length) / 2.0}"/>
    <xacro:property name="forearm_length" value="$(arg forearm_length)"/>
    <xacro:property name="forearm_com_y" value="${-float(forearm_length) / 2.0}"/>
    <xacro:property name="hand_length" value="$(arg hand_length)"/>
    <xacro:property name="mesh_dir" value="package://image_pose_tracking/meshes/human_subject_right_arm"/>

    <!--
        The meshes come from /home/yuxuan_cor/Downloads/humanSubjectWithMeshes.
        In that source URDF, RightUpperArm uses a 0.3162 m shoulder-elbow
        distance and RightForeArm uses a 0.2482 m elbow-wrist distance. The
        meshes are rotated by +pi/2 about X, so their local Z dimension maps to
        this model's negative-Y limb direction. The dynamic scale factors below
        preserve the original transverse scale and stretch only the limb length.
    -->
    <xacro:property name="source_upper_arm_length" value="0.3162"/>
    <xacro:property name="source_forearm_length" value="0.2482"/>
    <xacro:property name="source_hand_length" value="0.0918"/>
    <xacro:property name="upper_arm_mesh_scale_z" value="${1.03030303 * float(upper_arm_length) / source_upper_arm_length}"/>
    <xacro:property name="forearm_mesh_scale_z" value="${1.03030303 * float(forearm_length) / source_forearm_length}"/>
    <xacro:property name="hand_mesh_scale_y" value="${1.03030303 * float(hand_length) / source_hand_length}"/>
    <xacro:property name="color_code"  value="${
        '0.35 0.55 0.40 1' if color == 'green'
        else '0.25 0.45 0.65 1' if color == 'blue'
        else '0.72 0.70 0.65 1'}"/>

    <material name="color">
        <color rgba="${color_code}"/>
    </material>

    <material name="mesh_color">
        <color rgba="0.82 0.70 0.62 1.0"/>
    </material>

    <material name="torso_mesh_color">
        <color rgba="0.76 0.66 0.58 1.0"/>
    </material>

    <!--
        Static upper-torso visualization branch.

        This branch is deliberately attached to RightShoulder with fixed joints
        and is not inserted into the 7-DOF right-arm chain. RightShoulder remains
        the model root so an external camera -> RightShoulder TF can still drive
        the entire visualization.

        In the source mesh URDF:
          UpperTrunk -> RightShoulder = (0, -0.07338333333333334, 0.158)
          UpperTrunk -> LeftShoulder  = (0,  0.07338333333333334, 0.158)
        Therefore:
          RightShoulder -> UpperTorso = (0, 0.07338333333333334, -0.158)
    -->
    <joint name="${prefix}jRightShoulder_to_UpperTorso" type="fixed">
        <origin xyz="0 -0.073 -0.2" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder"/>
        <child link="${prefix}UpperTorso"/>
    </joint>

    <link name="${prefix}UpperTorso">
        <visual>
            <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/UpperTrunk.stl" scale="0.58333333 1.03030303 1.03030303"/>
            </geometry>
            <material name="torso_mesh_color"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
            <geometry>
                <box size="0.18 0.22 0.22"/>
            </geometry>
        </collision>
    </link>


    <link name="${prefix}RightShoulder">
        <visual>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/RightShoulder.stl" scale="0.64444444 0.64444444 1.03030303"/>
            </geometry>
            <material name="mesh_color"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <!--
        OSIM shoulder sequence from MOBL_ARMS_module5_scaleIK.osim:
        shoulder0/elv_angle, shoulder1/shoulder_elv, shoulder1_r2=-elv_angle,
        shoulder2/shoulder_rot. All joint origins remain at the shoulder center.
    -->
    <joint name="${prefix}jRightShoulder_elv_angle" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder"/>
        <child link="${prefix}RightShoulder_elv_angle"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.65806279" upper="2.26892803"/>
        <axis xyz="0.0048 0.99908918 0.04240001"/>
    </joint>

    <link name="${prefix}RightShoulder_elv_angle">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightShoulder_shoulder_elv" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder_elv_angle"/>
        <child link="${prefix}RightShoulder_shoulder_elv"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="0" upper="3.14159265"/>
        <axis xyz="-0.99826136 0.0023 0.05889802"/>
    </joint>

    <link name="${prefix}RightShoulder_shoulder_elv">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightShoulder_shoulder1_r2" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder_shoulder_elv"/>
        <child link="${prefix}RightShoulder_shoulder1_r2"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-2.26892803" upper="1.65806279"/>
        <axis xyz="0.0048 0.99908918 0.04240001"/>
        <mimic joint="${prefix}jRightShoulder_elv_angle" multiplier="-1.0" offset="0.0"/>
    </joint>

    <link name="${prefix}RightShoulder_shoulder1_r2">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightShoulder_shoulder_rot" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightShoulder_shoulder1_r2"/>
        <child link="${prefix}RightUpperArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.57079633" upper="2.09439510"/>
        <axis xyz="0.0048 0.99908918 0.04240001"/>
    </joint>

    <link name="${prefix}RightUpperArm">
        <inertial>
            <mass value="2.181"/>
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="0 0 0"/>
            <inertia ixx="0.020332" iyy="0.0013806" izz="0.020332" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/RightUpperArm.stl" scale="0.64444444 0.64444444 ${upper_arm_mesh_scale_z}"/>
            </geometry>
            <material name="mesh_color"/>
        </visual>
        <collision>
            <origin xyz="0 ${upper_arm_com_y} 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder length="${upper_arm_length}" radius="0.04"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}jRightElbow_rotz" type="revolute">
        <origin xyz="0 ${-float(upper_arm_length)} 0" rpy="0 0 0"/>
        <parent link="${prefix}RightUpperArm"/>
        <child link="${prefix}RightForeArm"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="0" upper="2.53073"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}RightForeArm">
        <inertial>
            <mass value="1.454"/>
            <origin xyz="0 ${forearm_com_y} 0" rpy="0 0 0"/>
            <inertia ixx="0.008948" iyy="0.00040906" izz="0.008948" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 ${forearm_com_y} 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/RightForeArm.stl" scale="0.61111111 0.61111111 ${forearm_mesh_scale_z}"/>
            </geometry>
            <material name="mesh_color"/>
        </visual>
        <collision>
            <origin xyz="0 ${forearm_com_y} 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder length="${forearm_length}" radius="0.035"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}jRightElbow_roty" type="revolute">
        <origin xyz="0 ${-float(forearm_length)} 0" rpy="0 0 0"/>
        <parent link="${prefix}RightForeArm"/>
        <child link="${prefix}RightForeArm_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.48353"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}RightForeArm_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightWrist_rotx" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightForeArm_f1"/>
        <child link="${prefix}RightHand_f1"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-1.5708" upper="1.5708"/>
        <axis xyz="1 0 0"/>
    </joint>

    <link name="${prefix}RightHand_f1">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="${prefix}jRightWrist_rotz" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}RightHand_f1"/>
        <child link="${prefix}RightHand"/>
        <dynamics damping="0.1" friction="0.0"/>
        <limit effort="30" velocity="1.0" lower="-0.723599" upper="0.549066"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}RightHand">
        <inertial>
            <mass value="0.4362"/>
            <origin xyz="0 ${-float(hand_length)} 0" rpy="0 0 0"/>
            <inertia ixx="0.0015471" iyy="0.00073303" izz="0.0021165" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 ${-float(hand_length)} 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/RightHand.stl" scale="0.9 ${hand_mesh_scale_y} 0.55555556"/>
            </geometry>
            <material name="mesh_color"/>
        </visual>
        <collision>
            <origin xyz="0 ${-float(hand_length)} 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 ${2.0 * float(hand_length)} 0.04"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}jRightHandCOM" type="fixed">
        <origin xyz="0 ${-float(hand_length)} 0" rpy="0 0 0"/>
        <parent link="${prefix}RightHand"/>
        <child link="${prefix}RightHandCOM"/>
    </joint>

    <link name="${prefix}RightHandCOM">
        <inertial>
            <mass value="0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

</robot>
